# The glashelder CLI, to run its web interfaces (`embed serve`, `artmatcher serve`, ...).
#
#   docker build -f Dockerfile.serve -t glashelder .
#   docker run --rm -p 5000:5000 -v /mnt/glashelder:/mnt/glashelder:ro \
#     -v ./demo:/work glashelder embed serve
#
# The working directory is /work: mount a directory there that holds the
# `glashelder.toml` to use, and that keeps what the servers write (labeling
# sessions, ...). Model downloads go to /cache, mount a volume there to keep them.
#
# By default torch is the CPU build of the locked version, which leaves out about
# 4 GB of CUDA libraries. For a host with an NVIDIA GPU, build with
# `--build-arg TORCH=cuda` to get the locked CUDA build.

FROM python:3.13-slim AS build

ARG TORCH=cpu

COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /bin/

# hdbscan has no wheel for this Python and is compiled; lightglue comes from git
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON_PREFERENCE=only-system

WORKDIR /app

# dependencies first, in their own layer: they change far less than the code
COPY pyproject.toml uv.lock README.md ./
COPY common/pyproject.toml common/README.md common/
COPY embed/pyproject.toml embed/README.md embed/
COPY cluster/pyproject.toml cluster/README.md cluster/
COPY preprocessing/pyproject.toml preprocessing/README.md preprocessing/
COPY glaswacht/pyproject.toml glaswacht/README.md glaswacht/
COPY artmatcher/pyproject.toml artmatcher/README.md artmatcher/
COPY artscraper/pyproject.toml artscraper/README.md artscraper/
COPY ocr/pyproject.toml ocr/README.md ocr/
COPY unstir/pyproject.toml unstir/README.md unstir/

# for the CPU build: the locked torch, torchvision and CUDA packages are skipped,
# then the CPU builds of the same torch and torchvision versions are installed
RUN case "$TORCH" in \
      cpu) grep -oE '^name = "(torch|torchvision|triton|nvidia-[a-z0-9-]+|cuda-[a-z-]+)"$' uv.lock \
             | cut -d'"' -f2 | sed 's/^/--no-install-package /' > /skip ;; \
      cuda) : > /skip ;; \
      *) echo "TORCH is cpu or cuda, not $TORCH" >&2; exit 1 ;; \
    esac
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace $(cat /skip)
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$TORCH" = cpu ]; then \
      locked() { grep -A1 "^name = \"$1\"$" uv.lock | sed -n 's/^version = "\(.*\)"$/\1/p'; }; \
      uv pip install --no-deps --index-url https://download.pytorch.org/whl/cpu \
        "torch==$(locked torch)" "torchvision==$(locked torchvision)"; \
    fi

COPY src src
COPY common/src common/src
COPY embed/src embed/src
COPY cluster/src cluster/src
COPY preprocessing/src preprocessing/src
COPY glaswacht/src glaswacht/src
COPY artmatcher/src artmatcher/src
COPY artscraper/src artscraper/src
COPY ocr/src ocr/src
COPY unstir/src unstir/src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --inexact $(cat /skip)

FROM python:3.13-slim

# libgl and glib for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/.venv /app/.venv

# writable for any user, so `docker run --user` works
RUN mkdir -p /work /cache && chmod 1777 /work /cache

ENV PATH="/app/.venv/bin:$PATH" \
    XDG_CACHE_HOME=/cache \
    HF_HOME=/cache/huggingface

WORKDIR /work

EXPOSE 5000 5001 5005

# as PID 1, Python ignores SIGTERM but stops on Ctrl+C
STOPSIGNAL SIGINT

ENTRYPOINT ["glashelder"]
CMD ["--help"]
