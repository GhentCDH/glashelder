[12.130408, "o", "\u001b[11;1H\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m╚\u001b[0m\u001b[38;5;94;48;5;16m════════════════════════════════════════\u001b[0m\u001b[38;5;94;48;5;16m╝\u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m╚\u001b[0m\u001b[38;5;94;48;5;16m════════════════════════════════════════\u001b[0m\u001b[38;5;94;48;5;16m╝\u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m╚\u001b[0m\u001b[38;5;94;48;5;16m═════════════════════════════════════════\u001b[0m\u001b[38;5;94;48;5;16m╝\u001b[0m\u001b[48;5;16m \u001b[0m\r\n\u001b[12;1H\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m╔\u001b[0m\u001b[38;5;94;48;5;16m═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════\u001b[0m\u001b[38;5;94;48;5;16m╗\u001b[0m\u001b[48;5;16m \u001b[0m\r\n\u001b[13;1H\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m║\u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;179;48;5;16m\u001b[0m\u001b[48;5;16m                                                                                                                           \u001b[0m\u001b[38;5;23;48;5;16m▆▆\u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m║\u001b[0m\u001b[48;5;16m \u001b[0m\r\n\u001b[14;1H\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m║\u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;179;48;5;16mProvide a safety assessment for the content provided by the user. Determine compliance or violation against our safety\u001b[0m\u001b[48;5;16m     \u001b[0m\u001b[7;38;5;23;48;5;16m  \u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m║\u001b[0m\u001b[48;5;16m \u001b[0m\r\n\u001b[15;1H\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m║\u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;179;48;5;16mpolicy by reviewing the following policy categories:\u001b[0m\u001b[48;5;16m                                                                       \u001b[0m\u001b[7;38;5;23;48;5;16m  \u001b[0m\u001b[48;5;16m \u001b[0m\u001b[38;5;94;48;5;16m║\u001b